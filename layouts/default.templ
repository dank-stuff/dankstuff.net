package layouts

import (
	"context"
	"fmt"
	"strings"
	"time"

	"dankstuff.net/data"
)

templ Default(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>DankStuff</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1, maximum-scale=2, user-scalable=yes"
			/>
			<meta
				name="keywords"
				content="dank,stuff,dankstuff,dank stuff,dank products,dank apps,dank sites"
			/>
			<meta name="og:title" content="DankStuff"/>
			<meta name="description" content="DankStuff is an open-source software company, providing services for free or reasonable prices."/>
			<meta name="og:description" content="DankStuff is an open-source software company, providing services for free or reasonable prices."/>
			<meta property="og:url" content="https://dankstuff.net"/>
			<meta
				property="og:image"
				content="https://dankstuff.net/assets/favicon-96x96.png"
			/>
			<link
				rel="icon"
				type="image/png"
				href="/assets/favicon-96x96.png"
				sizes="96x96"
			/>
			<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/>
			<link rel="shortcut icon" href="/assets/favicon.ico"/>
			<link
				rel="apple-touch-icon"
				sizes="180x180"
				href="/assets/apple-touch-icon.png"
			/>
			<meta name="apple-mobile-web-app-title" content="DankStuff"/>
			<link rel="stylesheet" href="/assets/css/tailwind.css"/>
		</head>
		<body
			style='
      background-image: url("/assets/bgs/marb18.webp"),
        linear-gradient(to right, #2e7d32, #FBC02D);
      background-repeat: repeat;
      padding: 0px;
      margin: 0px;
      background-position: center;
      background-attachment: fixed;
    '
		>
			@header()
			<main
				style="width: 100%; min-height: 80dvh;"
			>
				<section class="dank-container">
					@content
				</section>
			</main>
			@footer()
		</body>
	</html>
}

templ header() {
	<header class={ "flex", "gap-2", "flex-col", "min-h-10", "m-3", "xl:mx-[20%]" }>
		<div class={ "flex", "flex-col", "md:flex-row","gap-y-2", "justify-between", "items-center" }>
			<a href="/">
				<div class={ "flex", "items-center", "gap-1" }>
					<img src="/assets/favicon-96x96.png" alt="DankStuff logo" width="35" height="35"/>
					<h1 class={ "font-AudioNugget!", "text-2xl" }>DankStuff</h1>
				</div>
			</a>
			<div class={ "flex", "flex-col", "gap-2" }>
				<nav>
					<div class={ "grid", "gap-4", "grid-cols-2", "md:grid-cols-4", "w-full" }>
						<a class="nav-link" href="/about" { activePage(ctx, "/about") }>About</a>
						<a class="nav-link" href="/products" { activePage(ctx, "/products") }>Products</a>
						<a class="nav-link" href="/privacy" { activePage(ctx, "/privacy") }>Privacy</a>
						<a class="nav-link" href="/terms-of-use" { activePage(ctx, "/terms-of-use") }>Terms of Usage</a>
					</div>
				</nav>
			</div>
		</div>
	</header>
	<hr class={ "border-b-muted", "border-b", "m-0", "p-0", "h-0" }/>
}

func activePage(ctx context.Context, matchPath string) string {
	pathname, ok := ctx.Value("path-name").(string)
	if !ok {
		return ""
	}
	if pathname == "/" && pathname == matchPath {
		return "aria-current=page"
	}
	if strings.HasPrefix(pathname, matchPath) && matchPath != "/" {
		return "aria-current=page"
	}
	return ""
}

templ footer() {
	<footer class={ "m-0", "p-5", "text-dankwhite", "bg-dankblue", "flex", "flex-col", "justify-center", "w-full", "text-center" }>
		@formalFooter()
		@banners()
	</footer>
}

templ copyright() {
	{{ year := fmt.Sprint(time.Now().Year()) }}
	if year == "2025" {
		&copy; { year } DankStuff LLC
	} else {
		&copy; 2025 &dash; { fmt.Sprint(time.Now().Year()) } DankStuff LLC
	}
}

templ formalFooter() {
	<section id="footer" class={ "my-8", "mx-3", "xl:mx-[20%]" }>
		<div class={ "w-full", "grid", "grid-cols-1", "lg:grid-cols-4", "justify-between", "gap-4" }>
			<div class={ "h-14" }>
				<a
					class={ "flex", "items-center", "align-middle", "gap-1", "w-fit" }
					href="/"
				>
					<img
						src="/assets/favicon-96x96.png"
						alt="DankStuff logo"
						width="35"
						height="35"
					/>
					<p class={ "text-md", "font-AudioNugget!" }>DankStuff</p>
				</a>
				<p class={ "text-xs", "flex", "items-start" }>
					@copyright()
				</p>
			</div>
			{{
				products := make([]formalFooterSectionItem, 0, len(data.Products))
				for _, product := range data.Products {
					if product.WIP {
						continue
					}
					products = append(products, formalFooterSectionItem{
						Title: product.Title,
						Link:  product.Link,
					})
				}
			}}
			@formalFooterSection(formalFooterSectionProps{
				Title: "Products",
				Items: products,
			})
			@formalFooterSection(formalFooterSectionProps{
				Title: "Company",
				Items: []formalFooterSectionItem{
					{
						Title: "About",
						Link:  "/about",
					},
					{
						Title: "Privacy Policy",
						Link:  "/privacy",
					},
					{
						Title: "Terms of Use",
						Link:  "/terms-of-use",
					},
				},
			})
			@formalFooterSection(formalFooterSectionProps{
				Title: "Connect",
				Items: []formalFooterSectionItem{
					{
						Title: "X",
						Link:  "https://x.com/DankStuff_net",
					},
					{
						Title: "GitHub",
						Link:  "https://github.com/dank-stuff",
					},
					{
						Title: "Codeberg",
						Link:  "https://codeberg.org/dankstuff",
					},
					{
						Title: "E-Mail",
						Link:  "mailto:baraa@dankstuff.net",
					},
				},
			})
		</div>
	</section>
}

type formalFooterSectionItem struct {
	Title string
	Link  string
}

type formalFooterSectionProps struct {
	Title string
	Items []formalFooterSectionItem
}

templ formalFooterSection(props formalFooterSectionProps) {
	<div class={ "flex", "items-start", "flex-col" }>
		<h4 class={ "h-14", "text-md", "flex", "justify-center", "items-center", "font-medium", "font-AudioNugget!" }>
			{ props.Title }
		</h4>
		<ul class={ "flex", "flex-col", "gap-2" }>
			for _, item := range props.Items {
				<li class={ "flex","items-start" }>
					<a
						class={ "text-start", "hover:underline", "text-sm" }
						href={ item.Link }
						target="_blank"
					>
						{ item.Title }
					</a>
				</li>
			}
		</ul>
	</div>
}

templ banners() {
	<div class={ "flex", "gap-2", "flex-wrap", "justify-center", "my-5", "mx-2" }>
		<div class={ "flex", "justify-center", "items-center", "bg-[#2585cd]", "p-2", "max-h-10" }>
			<img
				class={ "h-6", "mx-1", "pixelated" }
				src="/assets/images/codeberg.webp"
				alt="source code"
				title="source code"
			/>
			<p>
				<a
					class="text-link"
					href="https://codeberg.org/dankstuff/dankstuff.net"
					target="_blank"
				>&nbsp;Source code</a>
			</p>
		</div>
		<a href="https://golang.org" target="_blank">
			<img
				class="icon-img pixelated"
				src="/assets/dank-imgs/builtwithgo.png"
				alt="Built with Go!"
				title="Built with Go!"
			/>
		</a>
		<a href="" target="_blank">
			<img
				class="icon-img pixelated"
				src="/assets/dank-imgs/dankstuffproduct.webp"
				alt="A DankStuff product!"
				title="A DankStuff product!"
			/>
		</a>
		<a href="https://lordbaraa.net" target="_blank">
			<img
				class="icon-img pixelated"
				src="https://lordbaraa.net/resources/images/madebybaraa.webp"
				alt="Made by Baraa"
				title="Made by Baraa"
			/>
		</a>
		<img
			class="icon-img pixelated"
			src="/assets/dank-imgs/fairlite.gif"
			alt="NEON"
			title="NEON"
		/>
		<img
			class="icon-img pixelated"
			src="/assets/dank-imgs/fastweb.gif"
			alt="This site is blazingly fast!"
			title="This site is blazingly fast!"
		/>
		<img
			class="icon-img pixelated"
			src="/assets/dank-imgs/geocitieswww.gif"
			alt="World Wide Web Vibes!"
			title="World Wide Web Vibes!"
		/>
		<img
			class="block h-10"
			style="image-rendering: pixelated"
			src="/assets/dank-imgs/worldwideweb_badge.gif"
			alt="coffee"
		/>
		<a href="https://buymeacoffee.com/mbaraa" target="_blank">
			<img
				class="block h-10"
				style="image-rendering: pixelated"
				src="/assets/dank-imgs/dollarspindownd.gif"
				alt="Buy me a coffee!"
				title="Buy me a coffee!"
			/>
		</a>
		<img
			class="icon-img pixelated"
			src="/assets/dank-imgs/hasmile.gif"
			alt="Smile or something, maybe your smile can save someone's life!"
			title="Smile or something, maybe your smile can save someone's life!"
		/>
		<img
			class="icon-img pixelated"
			src="/assets/dank-imgs/thispageviolatestos.gif"
			alt="JK JK!"
			title="JK JK!"
		/>
	</div>
}
